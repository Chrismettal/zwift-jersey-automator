# pyenv
#   For a library or package, than for a specific project
#   This is typically not needed if you're only using pyenv locally
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, some prefer not to.
# Pipfile.lock

# poetry
#   Poetry uses pyproject.toml, which should be in version control.
#   The poetry.lock file should also be included.
# poetry.lock

# pdm
#   Similar to Poetry, pdm.lock should be included.
# pdm.lock
#   .pdm-python
#   .pdm-build/

# PEP 582; used by e.g. Tach  version 2021.12.8
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath
*.sage.py

